<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% set page_title = block('title')|trim %}
        {% set page_description %}{% block meta_description %}LeBonFoyer met en relation adoptants et cédants autour d’annonces responsables, avec des règles de bien-être animal strictes.{% endblock %}{% endset %}
        {% set page_description = page_description|trim|replace({"\n": ' ', "\r": ' '}) %}
        <title>{{ page_title }}</title>
        <meta name="description" content="{{ page_description }}">
        <meta name="robots" content="{% block robots %}{{ seo_robots() }}{% endblock %}">
        {% block canonical %}{% if seo_indexable() %}<link rel="canonical" href="{{ seo_canonical() }}">{% endif %}{% endblock %}
        <meta name="theme-color" content="#1f6f54">
        <meta name="application-name" content="LeBonFoyer">
        <meta name="apple-mobile-web-app-title" content="LeBonFoyer">
        <meta name="format-detection" content="telephone=no">
        <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">
        <link rel="manifest" href="{{ asset('site.webmanifest') }}">
        <meta property="og:site_name" content="LeBonFoyer">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:title" content="{{ page_title }}">
        <meta property="og:description" content="{{ page_description }}">
        <meta property="og:url" content="{{ seo_canonical() }}">
        {% block social_image %}
            <meta property="og:image" content="{{ seo_default_image() }}">
            <meta property="og:image:type" content="image/png">
            <meta property="og:image:width" content="1200">
            <meta property="og:image:height" content="630">
            <meta property="og:image:alt" content="LeBonFoyer — adoption responsable de chats et de chiens">
            <meta name="twitter:image" content="{{ seo_default_image() }}">
            <meta name="twitter:image:alt" content="LeBonFoyer — adoption responsable de chats et de chiens">
        {% endblock %}
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ page_title }}">
        <meta name="twitter:description" content="{{ page_description }}">
        {% block preload %}{% endblock %}
        {{ seo_json_ld(seo_page_graph(page_title, page_description)) }}
        {% block structured_data %}{% endblock %}
        {% block stylesheets %}{{ encore_entry_link_tags('app') }}{% endblock %}
        {% block javascripts %}{{ encore_entry_script_tags('app') }}{% endblock %}
    </head>
    <body>
        <div class="skip-link"><a href="#main">Aller au contenu</a></div>
        <header class="site-header">
            <div class="container header-inner">
                <a class="brand" href="{{ path('app_home') }}">
                    <span class="brand-mark">🐾</span>
                    <span class="brand-name">LeBonFoyer</span>
                </a>
                <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Ouvrir le menu">
                <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span><span></span><span></span></label>
                <nav class="site-nav" aria-label="Navigation principale">
                    <a href="{{ path('app_listing_index') }}">Annonces</a>
                    <a href="{{ path('app_welfare_rules') }}">Bien-être animal</a>
                    {% if app.user %}
                        {% if is_granted('ROLE_CEDANT') %}
                            <a href="{{ path('app_listing_mine') }}">Mes annonces</a>
                            <a href="{{ path('app_application_received') }}">Demandes reçues</a>
                        {% endif %}
                        {% if is_granted('ROLE_ADOPTANT') %}
                            <a href="{{ path('app_application_mine') }}">Mes demandes</a>
                        {% endif %}
                        <a href="{{ path('app_message_index') }}">Messages</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_admin_dashboard') }}">Administration</a>
                        {% endif %}
                        <a class="nav-account" href="{{ path('app_account_profile') }}">{{ app.user.firstName ?: app.user.email }}</a>
                        <a class="btn btn-ghost btn-sm" href="{{ path('app_logout') }}">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}">Connexion</a>
                        <a class="btn btn-primary btn-sm" href="{{ path('app_register') }}">Créer un compte</a>
                    {% endif %}
                </nav>
            </div>
        </header>

        {% set flashes = app.flashes %}
        {% if flashes|length > 0 %}
            <div class="container flash-container" role="status" aria-live="polite">
                {% for type, messages in flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}

        <main id="main">
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="container footer-grid">
                <div>
                    <p class="brand footer-brand"><span class="brand-mark">🐾</span> LeBonFoyer</p>
                    <p class="muted">Adoption responsable de chats et de chiens.<br>Remise en mains propres, jamais de livraison.</p>
                </div>
                <div>
                    <h3>Adopter</h3>
                    <a href="{{ path('app_listing_index') }}">Toutes les annonces</a>
                    <a href="{{ path('app_listing_index', {species: 'cat'}) }}">Chats</a>
                    <a href="{{ path('app_listing_index', {species: 'dog'}) }}">Chiens</a>
                </div>
                <div>
                    <h3>Confiance</h3>
                    <a href="{{ path('app_welfare_rules') }}">Règles de bien-être</a>
                    <a href="{{ path('app_privacy') }}">Confidentialité &amp; RGPD</a>
                    <a href="{{ path('app_legal_mentions') }}">Mentions légales</a>
                </div>
                <div>
                    <h3>Compte</h3>
                    {% if app.user %}
                        <a href="{{ path('app_account_profile') }}">Mon profil</a>
                        <a href="{{ path('app_account_export') }}">Exporter mes données</a>
                    {% else %}
                        <a href="{{ path('app_login') }}">Connexion</a>
                        <a href="{{ path('app_register') }}">Inscription</a>
                    {% endif %}
                </div>
            </div>
            <div class="container footer-bottom">
                <p>© {{ current_year() }} LeBonFoyer — Plateforme solidaire, sans livraison ni paiement en ligne.</p>
            </div>
        </footer>
    </body>
</html>
