{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe — LeBonFoyer{% endblock %}

{% block body %}
<section class="section">
    <div class="container panel panel-narrow">
        <h1 style="font-size:1.9rem;">Changer de mot de passe</h1>
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.currentPassword) }}
            {{ form_row(form.plainPassword) }}
            <div class="form-actions">
                <button class="btn btn-primary" type="submit">Enregistrer</button>
                <a class="btn btn-ghost" href="{{ path('app_account_profile') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
</section>
{% endblock %}
