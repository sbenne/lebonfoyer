{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — LeBonFoyer{% endblock %}

{% block body %}
<section class="section">
    <div class="container panel panel-narrow">
        <h1 style="font-size:2rem;">Mot de passe oublié</h1>
        <p class="muted">Indiquez votre adresse email : nous vous enverrons un lien de réinitialisation valable une heure.</p>

        <form method="post" action="{{ path('app_forgot_password_request') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}">
            <div class="field">
                <label for="email">Adresse email</label>
                <input id="email" type="email" name="email" autocomplete="email" required autofocus>
            </div>
            <button class="btn btn-primary btn-block" type="submit">Envoyer le lien</button>
        </form>

        <p class="small muted" style="margin-top:1rem;"><a href="{{ path('app_login') }}">← Retour à la connexion</a></p>
    </div>
</section>
{% endblock %}
