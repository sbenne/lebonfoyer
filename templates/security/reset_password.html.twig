{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — LeBonFoyer{% endblock %}

{% block body %}
<section class="section">
    <div class="container panel panel-narrow">
        <h1 style="font-size:2rem;">Nouveau mot de passe</h1>
        <p class="muted">Choisissez un mot de passe d'au moins 12 caractères.</p>

        {{ form_start(resetForm, {action: path('app_reset_password', {token: token})}) }}
            {{ form_errors(resetForm) }}
            {{ form_row(resetForm.plainPassword) }}
            <button class="btn btn-primary btn-block" type="submit">Enregistrer le mot de passe</button>
        {{ form_end(resetForm) }}
    </div>
</section>
{% endblock %}
