{% extends 'base.html.twig' %}

{% block title %}Journal d'audit — Administration{% endblock %}

{% block body %}
<div class="page-head">
    <div class="container">
        <h1>Journal d'audit</h1>
        <p>Traçabilité des actions sensibles : réservations, remises, modération, comptes.</p>
    </div>
</div>

<section class="section-sm">
    <div class="container">
        <div class="table-wrap">
            <table>
                <thead><tr><th>Date</th><th>Action</th><th>Acteur</th><th>Sujet</th><th>Contexte</th></tr></thead>
                <tbody>
                    {% for log in logs %}
                        <tr>
                            <td class="muted small">{{ log.createdAt|fr_datetime }}</td>
                            <td><strong>{{ log.action }}</strong></td>
                            <td>{{ log.actor ? log.actor.fullName : 'Système' }}</td>
                            <td class="muted small">{{ log.subjectType ? log.subjectType|split('\\')|last : '' }} {{ log.subjectId ? '#' ~ log.subjectId : '' }}</td>
                            <td class="muted small"><code>{{ log.context|json_encode }}</code></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="muted">Aucune entrée.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</section>
{% endblock %}
