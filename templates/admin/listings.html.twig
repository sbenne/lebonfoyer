{% extends 'base.html.twig' %}

{% block title %}Modération des annonces — LeBonFoyer{% endblock %}

{% block body %}
<div class="page-head">
    <div class="container">
        <h1>Modération des annonces</h1>
        <p>Suspendre ou supprimer une annonce contraire aux règles.</p>
    </div>
</div>

<section class="section-sm">
    <div class="container">
        <div class="table-wrap">
            <table>
                <thead><tr><th>Animal</th><th>Cédant</th><th>Statut</th><th>Ville</th><th>Création</th><th>Actions</th></tr></thead>
                <tbody>
                    {% for listing in listings %}
                        <tr>
                            <td><strong><a href="{{ path('app_listing_show', {id: listing.id}) }}">{{ listing.name }}</a></strong><br><span class="muted small">{{ listing.species|species_label }}</span></td>
                            <td>{{ listing.cedant ? listing.cedant.fullName : '—' }}<br><span class="muted small">{{ listing.cedant ? listing.cedant.email : '' }}</span></td>
                            <td><span class="badge badge-{{ listing.status.value }}">{{ listing.status|listing_status_label }}</span></td>
                            <td>{{ listing.city }}</td>
                            <td class="muted small">{{ listing.createdAt|fr_date }}</td>
                            <td>
                                <div class="table-actions">
                                    {% if listing.status.value != 'suspended' %}
                                        <form method="post" action="{{ path('app_admin_listing_suspend', {id: listing.id}) }}" class="inline-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_suspend_listing_' ~ listing.id) }}">
                                            <button class="btn btn-ghost btn-sm" type="submit">Suspendre</button>
                                        </form>
                                    {% endif %}
                                    <form method="post" action="{{ path('app_admin_listing_delete', {id: listing.id}) }}" class="inline-form" onsubmit="return confirm('Supprimer définitivement ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_listing_' ~ listing.id) }}">
                                        <button class="btn btn-danger btn-sm" type="submit">Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="muted">Aucune annonce.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</section>
{% endblock %}
